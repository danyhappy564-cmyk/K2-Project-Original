<Project Sdk="Microsoft.NET.Sdk">

  <!-- K2 클라 플러그인(BepInEx) — 소총은 바닐라 M4A1 프리팹(애니메이션·사운드 원본)을 쓰고, 본체 메시만 K2로 바꾼다.
       참조는 실제 게임·BepInEx DLL(읽기만). 게임 폴더로 자동 배포하지 않는다 — Package-Mod.ps1이 묶는다. -->

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <Nullable>enable</Nullable>
    <RootNamespace>K2Original.Client</RootNamespace>
    <AssemblyName>K2.Client</AssemblyName>
    <LangVersion>latest</LangVersion>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <Import Project="$(MSBuildThisFileDirectory)..\LocalSettings.props" Condition="Exists('$(MSBuildThisFileDirectory)..\LocalSettings.props')" />

  <PropertyGroup>
    <SptRoot Condition="'$(SptRoot)' == '' And '$(SPT_ROOT)' != ''">$(SPT_ROOT)</SptRoot>
    <SptRoot Condition="'$(SptRoot)' == ''">E:\SPT 4.1</SptRoot>
    <Managed>$(SptRoot)\EscapeFromTarkov_Data\Managed</Managed>
    <BepInExCore>$(SptRoot)\BepInEx\core</BepInExCore>
  </PropertyGroup>

  <Target Name="ValidateSptRoot" BeforeTargets="BeforeBuild;ResolveAssemblyReferences">
    <Error Condition="!Exists('$(Managed)')" Text="SptRoot '$(SptRoot)' 아래에 EscapeFromTarkov_Data\Managed가 없습니다." />
  </Target>

  <ItemGroup>
    <Reference Include="Assembly-CSharp"><HintPath>$(Managed)\Assembly-CSharp.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine"><HintPath>$(Managed)\UnityEngine.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(Managed)\UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.AssetBundleModule"><HintPath>$(Managed)\UnityEngine.AssetBundleModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="BepInEx"><HintPath>$(BepInExCore)\BepInEx.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(BepInExCore)\0Harmony.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

</Project>
